{
  "extends": [
    "github>nuxt/renovate-config-nuxt"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "ignoreDeps": [
    "swrv"
  ],
  "packageRules": [
    {
      "matchDepTypes": [
        "resolutions"
      ],
      "enabled": false
    },
    {
      "groupName": "tiptap",
      "matchPackageNames": [
        "@tiptap/*"
      ]
    }
  ],
  "postUpdateOptions": [
    "pnpmDedupe"
  ]
}
