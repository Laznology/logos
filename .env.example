# Set production URL and environment in your deployment platform before enabling indexing.
NUXT_SITE_URL=https://example.com
NUXT_SITE_ENV=production

# Cloudflare Workers build-time resources
NUXT_HUB_CLOUDFLARE_DATABASE_ID=
NUXT_HUB_CLOUDFLARE_R2_BUCKET_NAME=

NUXT_PUBLIC_PARTYKIT_HOST=
# Vercel AI gateway key
AI_GATEWAY_API_KEY=

# Better Auth secret, at least 32 characters (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Public URL of the app, used for auth callbacks in production
BETTER_AUTH_URL=
